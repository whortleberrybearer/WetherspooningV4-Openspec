# Firebase Functions Environment Variables

# Google Geocoding API
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Geocoding API: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_GEOCODING_API_KEY=your-api-key-here

# Admin User ID for On-Demand Pub Sync
# Get your Firebase Auth UID from Firebase Console > Authentication > Users
# Or run: firebase auth:export users.json --format=JSON and find your UID
WETHERSPOONING_ADMIN_USER_ID=your-firebase-auth-uid-here
