rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pubs: Publicly readable, admin-only write
    match /pubs/{pubId} {
      // Allow anyone to read pub data
      allow read: if true;
      
      // Only allow writes from server/admin (via Admin SDK)
      // Client SDK writes are denied
      allow write: if false;
    }
    
    // Users: Public profiles with privacy settings
    match /users/{userId} {
      // Anyone can read user profiles (needed for username lookups and public visit viewing)
      allow read: if true;
      
      // Only the user can create their own profile
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.username is string
                    && request.resource.data.email is string
                    && request.resource.data.visitsPublic is bool
                    && request.resource.data.createdAt is string;
      
      // Only the user can update their own profile
      // Prevent UID modification after creation
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid;
      
      // Users cannot delete their profile directly (handled by account deletion flow)
      allow delete: if false;
    }
    
    // Visits: Users can read/write their own visits, or read public visits
    match /visits/{visitId} {
      // Helper function to validate rating field
      function isValidRating() {
        return !('rating' in request.resource.data) ||
               request.resource.data.rating == null ||
               (request.resource.data.rating is number && 
                request.resource.data.rating >= 1 && 
                request.resource.data.rating <= 5);
      }
      
      // Helper function to validate notes field
      function isValidNotes() {
        return !('notes' in request.resource.data) ||
               request.resource.data.notes == null ||
               request.resource.data.notes is string;
      }
      
      // Helper function to validate visitedAt field
      function isValidVisitedAt() {
        return !('visitedAt' in request.resource.data) ||
               request.resource.data.visitedAt == null ||
               request.resource.data.visitedAt is string;
      }
      
      // Helper function to check if user has public visits enabled
      function userHasPublicVisits() {
        return exists(/databases/$(database)/documents/users/$(resource.data.userId))
               && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.visitsPublic == true;
      }
      
      // Allow read if user is authenticated and visit belongs to them (own visits)
      // OR if the visit owner has enabled public sharing (shared visits)
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid)
                  || userHasPublicVisits();
      
      // Allow create if user is authenticated and setting their own userId
      // and all optional fields are valid
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && isValidRating()
                    && isValidNotes()
                    && isValidVisitedAt();
      
      // Allow update/delete if user is authenticated and visit belongs to them
      // and all optional fields are valid
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && isValidRating()
                    && isValidNotes()
                    && isValidVisitedAt();
                    
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
  }
}
